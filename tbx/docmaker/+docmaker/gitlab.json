{
  "name": "gitlab",
  "hostname": {
    "default": "gitlab.com",
    "variable": "DOCMAKER_GITLAB_HOSTNAME"
  },
  "request": {
    "method": "POST",
    "path": "/api/v4/markdown",
    "bodyFormat": "gfmJson",
    "contentType": "application/json",
    "accept": "application/json"
  },
  "authentication": {
    "required": true,
    "variable": "DOCMAKER_GITLAB_TOKEN",
    "header": "PRIVATE-TOKEN",
    "prefix": ""
  },
  "response": {
    "successStatusCode": 201,
    "format": "json",
    "htmlField": "html",
    "errorMessageField": "message"
  }
}
